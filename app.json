{
  "expo": {
    "name": "Malawi Market",
    "slug": "malawi-market",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "mw.wealthgrid.malawimarket",
    "newArchEnabled": true,
    "android": {
      "package": "mw.wealthgrid.malawimarket",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/logo.png"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Malawi Market to select product and profile photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Malawi Market to use your location for local weather and map features."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Malawi Market to use your camera to scan product QR codes.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "owner": "ndelemanis-team",
    "extra": {
      "eas": {
        "projectId": "2c8d3be6-6fc3-4f4d-907a-1214c606fe08"
      }
    },
    "icon": "./assets/logo.png",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    }
  }
}
